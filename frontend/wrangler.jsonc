{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "protolims-web-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "API_ORIGIN": "https://protolims-api-staging-516499981468.europe-west2.run.app",
  },
  "env": {
    "production": {
      "name": "protolims-web-production",
      "vars": {
        "API_ORIGIN": "https://protolims-api-production-516499981468.europe-west2.run.app",
      },
    },
  },
}
